#!/usr/bin/env python3
"""k8ctl - backlight control for stock-firmware Keychron keyboards on Linux.

Supports the Keychron K8 (USB 05ac:0250, confirmed working) and K3 v2
(05ac:024f, the device the protocol was originally documented on).

Protocol derived from two GPL implementations:
  - OpenRGB Controllers/KeychronKeyboardController (GPL-2.0-or-later)
  - github.com/mishamyrt/keychron-go (GPL-3.0)
This script is accordingly GPL-3.0.

Transport: 64-byte HID feature reports (report ID 0) on the keyboard's
control hidraw interface, 10 ms between packets. Use the USB cable, not
Bluetooth. Needs access to /dev/hidraw* (root, or the udev rule shown in
--help).
"""

import argparse
import array
import fcntl
import glob
import os
import sys
import time

SUPPORTED = ("000005AC:00000250",   # K8
             "000005AC:0000024F")   # K3 v2
PACKET_LEN = 64
PAGE_LEN = 16
HEADER = 0x04
CRC_L, CRC_H = 0xAA, 0x55

CMD_END = 0x02
CMD_INFO = 0x05
CMD_WRITE_EFFECTS = 0x13
CMD_CUSTOM_ON = 0x18
CMD_CUSTOM_OFF = 0x19
CMD_APPLY = 0xF0
EFFECT_PAGES = 0x12  # 18

MODES = {
    "custom": 0x00,
    "static": 0x01,
    "keystroke-light-up": 0x02,
    "keystroke-dim": 0x03,
    "sparkle": 0x04,
    "rain": 0x05,
    "random-colors": 0x06,
    "breathing": 0x07,
    "spectrum-cycle": 0x08,
    "ring-gradient": 0x09,
    "vertical-gradient": 0x0A,
    "horizontal-wave": 0x0B,
    "around-edges": 0x0C,
    "keystroke-horizontal-lines": 0x0D,
    "keystroke-tilted-lines": 0x0E,
    "keystroke-ripples": 0x0F,
    "sequence": 0x10,
    "wave-line": 0x11,
    "tilted-lines": 0x12,
    "back-and-forth": 0x13,
    "off": 0x80,
}
# The 20 effect-page slots, in on-wire order (custom has no page of its own).
PAGE_SLOTS = list(range(0x01, 0x14)) + [0x80]

DIRECTIONS = {"lr": 0, "rl": 1, "du": 2, "ud": 3}


def _ioc(dir_, nr, size):
    return (dir_ << 30) | (size << 16) | (ord("H") << 8) | nr


def hidiocsfeature(n):
    return _ioc(3, 0x06, n)


def hidiocgfeature(n):
    return _ioc(3, 0x07, n)


class Keyboard:
    def __init__(self, path, verbose=False):
        self.path = path
        self.verbose = verbose
        self.fd = os.open(path, os.O_RDWR)

    def close(self):
        os.close(self.fd)

    def send(self, data):
        buf = array.array("B", bytes([0x00]) + bytes(data).ljust(PACKET_LEN, b"\x00"))
        if self.verbose:
            print(f"  -> {bytes(buf[1:17]).hex(' ')} ...")
        fcntl.ioctl(self.fd, hidiocsfeature(len(buf)), buf, True)
        time.sleep(0.01)

    def read(self):
        buf = array.array("B", [0x00] * (PACKET_LEN + 1))
        fcntl.ioctl(self.fd, hidiocgfeature(len(buf)), buf, True)
        data = bytes(buf)
        if self.verbose:
            print(f"  <- {data[:20].hex(' ')} ...")
        time.sleep(0.01)
        return data

    def cmd(self, *payload, expect_ack=False):
        self.send(bytes([HEADER, *payload]))
        resp = self.read()
        if expect_ack:
            # ACK byte 0x01 (NACK 0xFF) is at data offset 3; depending on
            # how the kernel returns unnumbered reports it lands at buf[3]
            # or buf[4], so check both.
            window = resp[3:5]
            if 0xFF in window:
                raise RuntimeError(f"keyboard NACKed command {payload[0]:#04x}")
            if 0x01 not in window:
                print(f"warning: no clear ACK for {payload[0]:#04x}: "
                      f"{resp[:8].hex(' ')}", file=sys.stderr)
        return resp


def find_nodes():
    nodes = []
    for uevent in sorted(glob.glob("/sys/class/hidraw/hidraw*/device/uevent")):
        info = open(uevent).read()
        if any(vp in info for vp in SUPPORTED) and "Keychron" in info:
            nodes.append("/dev/" + uevent.split("/")[4])
    return nodes


def open_keyboard(verbose=False):
    """Return a Keyboard on the control interface, or raise RuntimeError."""
    nodes = find_nodes()
    if not nodes:
        raise RuntimeError(
            "No supported Keychron keyboard found. Is it plugged in via USB?")
    # The control interface is the one that accepts feature reports; probe
    # each candidate with GET_BASIC_INFO.
    last_err = None
    for path in reversed(nodes):
        try:
            kb = Keyboard(path, verbose)
        except PermissionError:
            raise RuntimeError(
                f"Permission denied on {path}. Run with sudo, or install the "
                "udev rule (see k8ctl --help).") from None
        try:
            kb.cmd(CMD_INFO)
            if verbose:
                print(f"using {path}")
            return kb
        except OSError as e:
            last_err = e
            kb.close()
    raise RuntimeError(
        f"No interface on {nodes} accepted feature reports ({last_err}).")


def build_page(mode_value, color, brightness, speed, direction, random_color):
    page = bytearray(PAGE_LEN)
    page[0] = mode_value
    if random_color:
        page[8] = 1
    else:
        page[1], page[2], page[3] = color
    page[9] = brightness
    page[10] = speed
    page[11] = direction
    page[14], page[15] = CRC_L, CRC_H
    return bytes(page)


def apply_settings(kb, mode_value, color, brightness, speed, direction,
                   random_color):
    is_custom = mode_value == MODES["custom"]
    kb.cmd(CMD_CUSTOM_ON if is_custom else CMD_CUSTOM_OFF)
    try:
        kb.cmd(CMD_WRITE_EFFECTS, 0, 0, 0, 0, 0, 0, EFFECT_PAGES,
               expect_ack=True)
    except RuntimeError:
        # Keyboard refused the write; close the transaction so it is not
        # left waiting for effect pages, then report.
        kb.cmd(CMD_END)
        raise

    # 5 packets x 4 effect pages: store the same settings under every mode,
    # so cycling modes with the lightbulb key keeps your color/brightness.
    selected = None
    for i in range(5):
        packet = bytearray(PACKET_LEN)
        for j in range(4):
            value = PAGE_SLOTS[i * 4 + j]
            page = build_page(value, color, brightness, speed, direction,
                              random_color)
            packet[j * PAGE_LEN:(j + 1) * PAGE_LEN] = page
            if value == mode_value or (value == 0x80 and is_custom):
                selected = page
        kb.send(packet)

    for _ in range(3):
        kb.send(bytes(PACKET_LEN))

    # Per-LED color buffer: 144 slots of [0x80, R, G, B].
    color_buf = bytearray(576)
    r, g, b = color if is_custom and not random_color else (0, 0, 0)
    for i in range(0, 576, 4):
        color_buf[i], color_buf[i + 1], color_buf[i + 2], color_buf[i + 3] = \
            0x80, r, g, b
    for p in range(9):
        kb.send(color_buf[p * PACKET_LEN:(p + 1) * PACKET_LEN])

    kb.send(selected)                      # active mode page, no header
    kb.cmd(CMD_END, expect_ack=True)
    kb.cmd(CMD_APPLY)                      # 04 F0, no read


def do_set(mode_name, color, brightness, speed, direction, random_color,
           verbose=False):
    kb = open_keyboard(verbose)
    try:
        apply_settings(kb, MODES[mode_name], color, brightness, speed,
                       direction, random_color)
    finally:
        kb.close()


def parse_color(s):
    s = s.lstrip("#")
    if len(s) != 6:
        raise argparse.ArgumentTypeError("color must be RRGGBB hex")
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


