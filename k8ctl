def run_gui(port, verbose, no_browser=False):
    import http.server
    import json
    import threading
    import webbrowser

    lock = threading.Lock()
    page = GUI_HTML.replace("__MODES__", json.dumps(list(MODES)))

    def do_apply(params):
        mode = params.get("mode", "static")
        if mode not in MODES:
            raise RuntimeError(f"unknown mode {mode!r}")
        color = parse_color(params.get("color", "#ffffff"))
        brightness = int(params.get("brightness", 15))
        speed = int(params.get("speed", 8))
        direction = DIRECTIONS.get(params.get("direction", "lr"), 0)
        if not (0 <= brightness <= 15 and 0 <= speed <= 15):
            raise RuntimeError("brightness and speed must be 0-15")
        with lock:
            do_set(mode, color, brightness, speed, direction,
                   bool(params.get("random")), verbose)
        return f"applied {mode}"

    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, code, body, ctype="application/json"):
            data = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype + "; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def _host_ok(self):
            host = (self.headers.get("Host") or "").split(":")[0]
            return host in ("127.0.0.1", "localhost")

        def do_GET(self):
            if not self._host_ok():
                return self._send(403, '{"ok": false, "message": "bad host"}')
            if self.path in ("/", "/index.html"):
                return self._send(200, page, "text/html")
            self._send(404, '{"ok": false, "message": "not found"}')

        def do_POST(self):
            import json as _json
            if not self._host_ok():
                return self._send(403, '{"ok": false, "message": "bad host"}')
            try:
                n = int(self.headers.get("Content-Length") or 0)
                params = _json.loads(self.rfile.read(n) or b"{}")
                if self.path == "/api/set":
                    msg = do_apply(params)
                elif self.path == "/api/off":
                    with lock:
                        do_set("off", (0, 0, 0), 0, 0, 0, False, verbose)
                    msg = "backlight off"
                else:
                    return self._send(404, '{"ok": false, "message": "not found"}')
                self._send(200, _json.dumps({"ok": True, "message": msg}))
            except Exception as e:
                self._send(200, _json.dumps({"ok": False, "message": str(e)}))

        def log_message(self, fmt, *args):
            if verbose:
                super().log_message(fmt, *args)

    # Fail early with a clear message if the keyboard is unreachable.
    try:
        open_keyboard(verbose).close()
    except RuntimeError as e:
        sys.exit(str(e))

    url = f"http://127.0.0.1:{port}/"
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as e:
        if e.errno == 98:  # EADDRINUSE
            sys.exit(f"K8 Control is already running — open {url}\n"
                     f"(or start a second instance with --port <other>)")
        raise
    print(f"K8 Control running at {url}  (Ctrl-C to stop)")
    if not no_browser:
        threading.Timer(0.3, webbrowser.open, (url,)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nbye")


# ----------------------------------------------------------------- CLI ---

def main():
    epilog = """examples:
  k8ctl gui                                  web interface on localhost
  k8ctl probe
  k8ctl set static --color ff2a00 --brightness 15
  k8ctl set breathing --color 00ff88 --speed 10
  k8ctl set spectrum-cycle --speed 15
  k8ctl set custom --color 2040ff            (uniform per-LED color)
  k8ctl off

device access without sudo (recommended) - install a udev rule:
  echo 'KERNEL=="hidraw*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="0250", TAG+="uaccess"' \\
    | sudo tee /etc/udev/rules.d/70-keychron-k8.rules
  sudo udevadm control --reload && replug the keyboard
  (for a K3 v2 use idProduct "024f")
"""
    ap = argparse.ArgumentParser(
        prog="k8ctl", description=__doc__.splitlines()[0], epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="print raw packets")
    sub = ap.add_subparsers(dest="command", required=True)

    sub.add_parser("probe", help="read basic info (safe connectivity test)")
    sub.add_parser("modes", help="list available lighting modes")
    sub.add_parser("off", help="turn backlight off")

    gp = sub.add_parser("gui", help="start the local web interface")
    gp.add_argument("--port", type=int, default=8688)
    gp.add_argument("--no-browser", action="store_true",
                    help="don't open the browser automatically")

    sp = sub.add_parser("set", help="set mode / color / brightness / speed")
    sp.add_argument("mode", choices=sorted(MODES))
    sp.add_argument("--color", type=parse_color, default=(255, 255, 255),
                    metavar="RRGGBB")
    sp.add_argument("--random", action="store_true",
                    help="random colors instead of a fixed color")
    sp.add_argument("--brightness", type=int, default=15, metavar="0-15")
    sp.add_argument("--speed", type=int, default=8, metavar="0-15")
    sp.add_argument("--direction", choices=sorted(DIRECTIONS), default="lr",
                    help="lr, rl, du (down-up), ud (up-down)")

    args = ap.parse_args()

    if args.command == "modes":
        for name, value in MODES.items():
            print(f"{name:28s} {value:#04x}")
        return
    if args.command == "gui":
        return run_gui(args.port, args.verbose, args.no_browser)

    try:
        if args.command == "probe":
            kb = open_keyboard(args.verbose)
            try:
                resp = kb.cmd(CMD_INFO)
                print(f"device responded on {kb.path}: {resp[:24].hex(' ')}")
                print("Looks alive. Feature-report channel works.")
            finally:
                kb.close()
        elif args.command == "off":
            do_set("off", (0, 0, 0), 0, 0, 0, False, args.verbose)
            print("backlight off")
        else:
            for v in (args.brightness, args.speed):
                if not 0 <= v <= 15:
                    sys.exit("brightness and speed must be 0-15")
            do_set(args.mode, args.color, args.brightness, args.speed,
                   DIRECTIONS[args.direction], args.random, args.verbose)
            print(f"applied: {args.mode}"
                  + ("" if args.random else " #%02x%02x%02x" % args.color)
                  + f" brightness={args.brightness} speed={args.speed}")
    except RuntimeError as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
